# SHULE CAFE Apache Configuration
DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Auto-strip trailing commas accidentally typed in browser URL (e.g. login.html,)
    RewriteCond %{REQUEST_URI} ,+$
    RewriteRule ^(.*),+$ /shule-cafe/$1 [R=301,L]
</IfModule>

# Security & Zero-Stale-Cache Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"

    # Prevent aggressive browser caching on HTML, JS, JSON, and PHP files
    <FilesMatch "\.(html|htm|js|json|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Block access to sensitive files
<FilesMatch "(^\.env|\.(sql|bak|log|md|sh)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

